  "player": {
    "input": {
      "midi#main": {
        "active": true,
        "port": "KOMPLETE KONTROL S61 MK2:KOMPLETE KONTROL S61 MK2 MIDI 1 24:0",
        "analysers": {
          "midi_notes": {
            "active": false,
            "responsiveness": 0.5,
            "controls": { "intensity": "velocity" }
