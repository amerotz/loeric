          "midi_notes#intensity_velocity_tempo": {
            "active": true,
            "responsiveness": 1,
            "controls": {
              "global_intensity": "velocity",
              "velocity_tempo_impact": "velocity"
            }
          },
          "midi_notes#tempo": {
            "active": true,
            "responsiveness": 0.7,
            "controls": { "tempo_intensity": "velocity" }
          }
        }
      }
    },
    "output": {
      "soundfont": {
        "active": true,
        "device": "default",
        "channels": 2,
        "volume": 1,
        "samplerate": 41000,
        "path": "/usr/share/sounds/sf2/FluidR3_GM.sf2",
        "gain": 0,
        "program": "var_instrument_program",
        "send_cc": true,
        "send_messages": true,
        "velocity_range": [1, 127],
        "pitchbend_range": 2,
        "controls": {
          "$velocity": 1
        }
      }
    }
