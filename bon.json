        "weights": "var_velocity_weight",
        "savgol": false,
        "scale": true,
        "shift": true
      }
    },
    "notes_per_bar": {
      "o_canainn": {
        "weights": "var_velocity_weight",
        "savgol": false,
        "scale": true,
        "shift": true
      }
    },
    "velocity": {
      "weighted_sum": {
        "contours": {
          "o_canainn": {
            "weights": "var_velocity_weight",
            "savgol": false,
            "scale": true,
            "shift": false
          },
          "weighted_sum": {
            "contours": {
              "scale#low_pitch": {
                "contours": {
                  "clamp": {
                    "contours": {
                      "linear": {
                        "contours": {
                          "pitch": { "scale": true, "shift": true }
                        },
                        "a": -1,
                        "b": 0.5
                      }
                    },
                    "low": 0
                  }
                },
                "min": 0,
                "max": 1
              },
              "scale#high_pitch": {
                "contours": {
                  "clamp": {
                    "contours": {
                      "linear": {
                        "contours": {
                          "pitch": { "scale": true, "shift": true }
                        },
                        "a": 1,
                        "b": -0.5
                      }
                    },
                    "low": 0
                  }
                },
                "min": 0,
                "max": 1
              }
            },
            "weights": [1, 1],
            "normalize": false
          },
          "scale#3": {
            "contours": {
              "multiply": {
                "contours": {
                  "phrase_arch#2": {
                    "accelerando": 0.5,
                    "ritardando": 1,
                    "last": 0.2,
