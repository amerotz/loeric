                    "ritardando": 1,
                    "last": 0.2,
                    "turn": 0.4,
                    "power": 2,
                    "phrase_length": "var_phrase_length_1",
                    "shift": null,
                    "mode": "contour"
                  }
                }
              }
            },
            "min": 0.5,
            "max": 1
          }
        },
        "weights": [0.25, 0.25, 0.5]
      }
    },
