          "default": null,
          "title": "Required Tags"
        },
        "chord_score": {
          "items": { "type": "number" },
          "title": "Chord Score",
          "type": "array"
        },
        "chords_per_bar": {
          "anyOf": [{ "type": "number" }, { "type": "null" }],
          "title": "Chords Per Bar"
        },
        "weights": {
          "additionalProperties": {
            "items": { "type": "number" },
            "type": "array"
          },
          "title": "Weights",
          "type": "object"
        },
        "type": { "const": "harmony", "title": "Type", "type": "string" }
      },
      "required": ["chord_score", "chords_per_bar", "weights", "type"],
      "title": "HarmonyModuleConfig",
      "type": "object"
    },
