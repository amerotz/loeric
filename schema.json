{
  "$defs": {
    "AudioInputConfig": {
      "additionalProperties": false,
      "properties": {
        "type": { "const": "audio", "title": "Type", "type": "string" },
        "active": { "title": "Active", "type": "boolean" },
        "analysers": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "better_rms": "#/$defs/BetterRMSConfig",
                "midi_cc": "#/$defs/MIDIContourAnalyserConfig",
                "midi_logger": "#/$defs/MIDILoggerConfig",
                "osc_cc": "#/$defs/OSCContourAnalyserConfig",
                "osc_logger": "#/$defs/OSCLoggerConfig",
                "rms": "#/$defs/RMSConfig",
                "tempo": "#/$defs/TempoAnalyserConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              { "$ref": "#/$defs/RMSConfig" },
              { "$ref": "#/$defs/BetterRMSConfig" },
              { "$ref": "#/$defs/TempoAnalyserConfig" },
              { "$ref": "#/$defs/MIDIContourAnalyserConfig" },
              { "$ref": "#/$defs/MIDILoggerConfig" },
              { "$ref": "#/$defs/OSCContourAnalyserConfig" },
              { "$ref": "#/$defs/OSCLoggerConfig" }
            ]
          },
          "title": "Analysers",
          "type": "object"
        },
        "device": { "title": "Device", "type": "string" },
        "samplerate": { "title": "Samplerate", "type": "integer" }
      },
      "required": ["type", "active", "analysers", "device", "samplerate"],
      "title": "AudioInputConfig",
      "type": "object"
    },
    "BetterRMSConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`BetterRMS`.\n\n:param controls: list of control names this analyser publishes values to.\n:param responsiveness: exponential smoothing factor in [0, 1].\n:param max_recovery: recovery rate of max value towards the current signal.\n:param min_recovery: recovery rate of min value towards the current signal.\n:param max_slack_factor: slack added to new maximum values\n(fraction of latest delta).\n:param min_slack_factor: slack added to new minimum values\n(fraction of latest delta).",
      "properties": {
        "type": { "const": "better_rms", "title": "Type", "type": "string" },
        "active": { "title": "Active", "type": "boolean" },
        "updates_per_second": {
          "title": "Updates Per Second",
          "type": "number"
        },
        "windows_per_second": {
          "title": "Windows Per Second",
          "type": "number"
        },
        "samplerate": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": 44100,
          "title": "Samplerate"
        },
        "controls": {
          "items": { "type": "string" },
          "title": "Controls",
          "type": "array"
        },
        "responsiveness": { "title": "Responsiveness", "type": "number" },
        "max_recovery": { "title": "Max Recovery", "type": "number" },
        "min_recovery": { "title": "Min Recovery", "type": "number" },
        "max_slack_factor": { "title": "Max Slack Factor", "type": "number" },
        "min_slack_factor": { "title": "Min Slack Factor", "type": "number" }
      },
      "required": [
        "type",
        "active",
        "updates_per_second",
        "windows_per_second",
        "controls",
        "responsiveness",
        "max_recovery",
        "min_recovery",
        "max_slack_factor",
        "min_slack_factor"
      ],
      "title": "BetterRMSConfig",
      "type": "object"
    },
    "BowedDroneConfig": {
      "additionalProperties": false,
      "properties": {
        "active": { "title": "Active", "type": "boolean" },
        "bind": { "title": "Bind", "type": "string" },
        "threshold": { "title": "Threshold", "type": "number" },
        "probability_scale": {
          "default": true,
          "title": "Probability Scale",
          "type": "boolean"
        },
        "allow_root": { "title": "Allow Root", "type": "boolean" },
        "notes": {
          "items": { "type": "number" },
          "title": "Notes",
          "type": "array"
        },
        "transpose": { "title": "Transpose", "type": "number" },
        "harmony_weight": {
          "default": 0.75,
          "title": "Harmony Weight",
          "type": "number"
        },
        "reference_weight": {
          "default": 0.25,
          "title": "Reference Weight",
          "type": "number"
        },
        "polyphony_min": { "title": "Polyphony Min", "type": "integer" },
        "polyphony_max": { "title": "Polyphony Max", "type": "integer" },
        "velocity_bind": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Velocity Bind"
        },
        "velocity_multiplier": {
          "title": "Velocity Multiplier",
          "type": "number"
        },
        "type": { "const": "bowed", "title": "Type", "type": "string" },
        "notes_per_bar": {
          "items": { "type": "integer" },
          "title": "Notes Per Bar",
          "type": "array"
        },
        "notes_per_bar_bind": {
          "title": "Notes Per Bar Bind",
          "type": "string"
        },
        "delay_bind": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Delay Bind"
        },
        "delay_range": {
          "anyOf": [{ "type": "number" }, { "type": "null" }],
          "default": null,
          "title": "Delay Range"
        }
      },
      "required": [
        "active",
        "bind",
        "threshold",
        "allow_root",
        "notes",
        "transpose",
        "polyphony_min",
        "polyphony_max",
        "velocity_multiplier",
        "type",
        "notes_per_bar",
        "notes_per_bar_bind"
      ],
      "title": "BowedDroneConfig",
      "type": "object"
    },
    "ChainModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`ChainModule`.\n\n:param modules: a chain of module configurations.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Required Tags"
        },
        "modules": {
          "additionalProperties": true,
          "title": "Modules",
          "type": "object"
        },
        "type": { "const": "chain", "title": "Type", "type": "string" }
      },
      "required": ["modules", "type"],
      "title": "ChainModuleConfig",
      "type": "object"
    },
    "ConditionConfig": {
      "description": "Config for a :class:`LOERICCondition`.\n\n:param attribute: element attribute to test.\n:param operation: comparison operator string.\n:param value: value to compare against.",
      "properties": {
        "attribute": { "title": "Attribute", "type": "string" },
        "operation": { "title": "Operation", "type": "string" },
        "value": { "title": "Value" }
      },
      "required": ["attribute", "operation", "value"],
      "title": "ConditionConfig",
      "type": "object"
    },
    "ConditionalModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`ConditionalModule`.\n\n:param condition: the condition to evaluate.\n:param module: a single-key dict mapping a module name to its config.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Required Tags"
        },
        "condition": { "$ref": "#/$defs/ConditionConfig" },
        "module": {
          "additionalProperties": true,
          "title": "Module",
          "type": "object"
        },
        "type": { "const": "conditional", "title": "Type", "type": "string" }
      },
      "required": ["condition", "module", "type"],
      "title": "ConditionalModuleConfig",
      "type": "object"
    },
    "DataOutputConfig": {
      "additionalProperties": true,
      "properties": {
        "type": { "const": "data", "title": "Type", "type": "string" },
        "active": { "title": "Active", "type": "boolean" },
        "path": { "title": "Path", "type": "string" },
        "format": { "title": "Format", "type": "string" },
        "controls": {
          "items": { "type": "string" },
          "title": "Controls",
          "type": "array"
        }
      },
      "required": ["type", "active", "path", "format", "controls"],
      "title": "DataOutputConfig",
      "type": "object"
    },
    "DelayBufferModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`DelayBufferModule`.\n\n:param size: lookahead buffer size in eighths. Must be positive.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Required Tags"
        },
        "size": { "title": "Size", "type": "number" },
        "type": { "const": "delay_buffer", "title": "Type", "type": "string" }
      },
      "required": ["size", "type"],
      "title": "DelayBufferModuleConfig",
      "type": "object"
    },
    "DroneModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`DroneModule`.\n\n:param data: mapping of drone names to their individual configs.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Required Tags"
        },
        "type": { "const": "drones", "title": "Type", "type": "string" },
        "data": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "bowed": "#/$defs/BowedDroneConfig",
                "free": "#/$defs/FreeDroneConfig",
                "pedal": "#/$defs/PedalDroneConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              { "$ref": "#/$defs/BowedDroneConfig" },
              { "$ref": "#/$defs/FreeDroneConfig" },
              { "$ref": "#/$defs/PedalDroneConfig" }
            ]
          },
          "title": "Data",
          "type": "object"
        }
      },
      "required": ["type", "data"],
      "title": "DroneModuleConfig",
      "type": "object"
    },
    "DynamicsModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`DynamicsModule`.\n\n:param bind: contour name controlling velocity.\n:param pattern: contour name for the velocity pattern multiplier.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Required Tags"
        },
        "bind": { "title": "Bind", "type": "string" },
        "pattern": { "default": null, "title": "Pattern", "type": "string" },
        "type": { "const": "dynamics", "title": "Type", "type": "string" }
      },
      "required": ["bind", "type"],
      "title": "DynamicsModuleConfig",
      "type": "object"
    },
    "FreeDroneConfig": {
      "additionalProperties": false,
      "properties": {
        "active": { "title": "Active", "type": "boolean" },
        "bind": { "title": "Bind", "type": "string" },
        "threshold": { "title": "Threshold", "type": "number" },
        "probability_scale": {
          "default": true,
          "title": "Probability Scale",
          "type": "boolean"
        },
        "allow_root": { "title": "Allow Root", "type": "boolean" },
        "notes": {
          "items": { "type": "number" },
          "title": "Notes",
          "type": "array"
        },
        "transpose": { "title": "Transpose", "type": "number" },
        "harmony_weight": {
          "default": 0.75,
          "title": "Harmony Weight",
          "type": "number"
        },
        "reference_weight": {
          "default": 0.25,
          "title": "Reference Weight",
          "type": "number"
        },
        "polyphony_min": { "title": "Polyphony Min", "type": "integer" },
        "polyphony_max": { "title": "Polyphony Max", "type": "integer" },
        "velocity_bind": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Velocity Bind"
        },
        "velocity_multiplier": {
          "title": "Velocity Multiplier",
          "type": "number"
        },
        "type": { "const": "free", "title": "Type", "type": "string" },
        "sync_with_notes": {
          "default": false,
          "title": "Sync With Notes",
          "type": "boolean"
        },
        "notes_per_bar": {
          "items": { "type": "integer" },
          "title": "Notes Per Bar",
          "type": "array"
        },
        "notes_per_bar_bind": {
          "title": "Notes Per Bar Bind",
          "type": "string"
        },
        "ascending": { "title": "Ascending", "type": "boolean" },
        "delay_bind": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Delay Bind"
        },
        "delay_range": {
          "anyOf": [{ "type": "number" }, { "type": "null" }],
          "default": null,
          "title": "Delay Range"
        }
      },
      "required": [
        "active",
        "bind",
        "threshold",
        "allow_root",
        "notes",
        "transpose",
        "polyphony_min",
        "polyphony_max",
        "velocity_multiplier",
        "type",
        "notes_per_bar",
        "notes_per_bar_bind",
        "ascending"
      ],
      "title": "FreeDroneConfig",
      "type": "object"
    },
    "GrooverConfig": {
      "description": "Configuration that maps pipeline stage names to config model instances.",
      "properties": {
        "modules": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "chain": "#/$defs/ChainModuleConfig",
                "conditional": "#/$defs/ConditionalModuleConfig",
                "delay_buffer": "#/$defs/DelayBufferModuleConfig",
                "drones": "#/$defs/DroneModuleConfig",
                "dynamics": "#/$defs/DynamicsModuleConfig",
                "harmony": "#/$defs/HarmonyModuleConfig",
                "history_buffer": "#/$defs/HistoryBufferModuleConfig",
                "legato": "#/$defs/LegatoModuleConfig",
                "logger": "#/$defs/LoggerModuleConfig",
                "ornament": "#/$defs/OrnamentModuleConfig",
                "swing": "#/$defs/SwingModuleConfig",
                "tagger": "#/$defs/TaggerModuleConfig",
                "timing": "#/$defs/TimingModuleConfig",
                "transpose": "#/$defs/TransposeModuleConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              { "$ref": "#/$defs/HarmonyModuleConfig" },
              { "$ref": "#/$defs/SwingModuleConfig" },
              { "$ref": "#/$defs/LegatoModuleConfig" },
              { "$ref": "#/$defs/DynamicsModuleConfig" },
              { "$ref": "#/$defs/TimingModuleConfig" },
              { "$ref": "#/$defs/TransposeModuleConfig" },
              { "$ref": "#/$defs/DelayBufferModuleConfig" },
              { "$ref": "#/$defs/HistoryBufferModuleConfig" },
              { "$ref": "#/$defs/OrnamentModuleConfig" },
              { "$ref": "#/$defs/DroneModuleConfig" },
              { "$ref": "#/$defs/ConditionalModuleConfig" },
              { "$ref": "#/$defs/LoggerModuleConfig" },
              { "$ref": "#/$defs/ChainModuleConfig" },
              { "$ref": "#/$defs/TaggerModuleConfig" }
            ]
          },
          "title": "Modules",
          "type": "object"
        }
      },
      "required": ["modules"],
      "title": "GrooverConfig",
      "type": "object"
    },
    "HarmonyModuleConfig": {
      "additionalProperties": false,
      "description": "Config for :class:`HarmonyModule`.\n\n:param chord_score: 12-element list scoring chord roots.\n:param chords_per_bar: how many chords to generate per bar.\n:param weights: mapping of mode names to 12-element weight arrays.",
      "properties": {
        "bypass": { "default": false, "title": "Bypass", "type": "boolean" },
        "tag": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Tag"
        },
        "required_tags": {
          "anyOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
