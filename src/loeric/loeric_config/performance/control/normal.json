{
  "player": {
    "mic_input": {
      "active": true,
      "type": "audio",
      "device": "pulse",
      "samplerate": 44100,
      "analysers": {
        "loudness": {
          "type": "rms",
          "responsiveness": 0.5,
          "controls": ["intensity", "autonomy"],
          "updates_per_second": 30
        }
      }
    }
  },
  "mapper": {
    "sources": [
      "velocity",
      "ornament",
      "tempo",
      "drone",
      "intensity",
      "autonomy"
    ],
    "targets": [],
    "rules": [
      "autonomy : %velocity,%ornament,%tempo,%drone",
      "intensity ~ velocity,ornament,tempo,drone"
    ]
  }
}
