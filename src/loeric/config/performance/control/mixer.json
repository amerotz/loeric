{
  "modules": {
    "dynamics": {
      "bind": "$velocity"
    },
    "ornament": {
      "bind": "$ornament"
    },
    "timing": {
      "bind": "$tempo",
      "qpm_amount": 50
    },
    "legato": {
      "bind": "$legato",
      "min": 0.1,
      "max": 1
    }
  },
  "player": {
    "input": {
      "main": {
        "active": true,
        "type": "midi",
        "port": "Launch Control XL Launch Contro",
        "analysers": {
          "control_changes": {
            "type": "midi_cc",
            "controls": {
              "velocity_i": 77,
              "tempo_i": 78,
              "ornament_i": 79,
              "legato_i": 80,
              "velocity_a": 77,
              "tempo_a": 78,
              "ornament_a": 79,
              "legato_a": 80
            }
          }
        }
      }
    }
  },
  "mapper": {
    "sources": [
      "ornament",
      "legato",
      "velocity",
      "tempo",
      "ornament_i",
      "legato_i",
      "velocity_i",
      "tempo_i",
      "ornament_a",
      "legato_a",
      "velocity_a",
      "tempo_a"
    ],
    "targets": [],
    "rules": [
      "ornament_a : %ornament",
      "ornament_i ~ ornament",
      "legato_a : %legato",
      "legato_i ~ legato",
      "tempo_a : %tempo",
      "tempo_i ~ tempo",
      "velocity_a : %velocity",
      "velocity_i ~ velocity"
    ]
  }
}
