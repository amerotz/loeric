{
  "variables": {
    "var_phrase_length_2": 4,
    "var_phrase_length_1": 8,
    "var_velocity_multiplier": 0.75
  },
  "modules": {
    "ornament": {
      "bind": "ornament"
    },
    "swing": {
      "bypass": true
    },
    "timing": {
      "qpm_amount": 20
    },
    "legato": {
      "min": 0.6,
      "max": 1
    }
  },
  "player": {
    "input": {
      "audio_mic_1": {
        "type": "audio",
        "active": true,
        "device": "pulse",
        "samplerate": 44100,
        "analysers": {
          "loudness": {
            "type": "rms",
            "responsiveness": 1,
            "controls": ["global_intensity", "velocity_tempo_impact"],
            "updates_per_second": 30
          },
          "tempo": {
            "type": "rms",
            "responsiveness": 0.7,
            "controls": ["tempo_intensity"],
            "updates_per_second": 30
          }
        }
      }
    }
  },
  "mapper": {
    "sources": [
      "global_intensity",
      "tempo_intensity",
      "velocity_tempo_impact",
      "tempo",
      "velocity",
      "legato",
      "drone"
    ],
    "targets": [],
    "rules": [
      "global_intensity @ [0,0.35]",
      "global_intensity @ [0.35,0.8] !",
      "global_intensity @ [0.8,1]",
      "velocity_tempo_impact @ [0,0.35] > [0.5,0.675]",
      "velocity_tempo_impact @ [0.35,0.8] > [0.825,0.6]",
      "velocity_tempo_impact @ [0.8,1] > [0.9,1]",
      "tempo_intensity @ [0,0.7]",
      "tempo_intensity @ [0.7,1] !",

      "0.5 : %drone",
      "1 : %legato",
      "velocity_tempo_impact : %velocity,%tempo",

      "global_intensity @ [0,0.35] ~ velocity,legato,drone",
      "global_intensity @ [0.35,0.8] ~ velocity,legato,drone",
      "global_intensity @ [0.8,1] ~ velocity,legato,drone",
      "tempo_intensity @ [0,0.7] ~ tempo",
      "tempo_intensity @ [0.7,1] ~ tempo"
    ]
  }
}
