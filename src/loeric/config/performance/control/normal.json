{
  "variables": {
    "var_drone_bind": "$drone"
  },
  "modules": {
    "dynamics": {
      "bind": "$velocity"
    },
    "ornament": {
      "bind": "$ornament"
    },
    "timing": {
      "bind": "$tempo"
    },
    "legato": {
      "bind": "$legato"
    }
  },
  "player": {
    "input": {
      "mic_input": {
        "active": true,
        "type": "audio",
        "device": "default",
        "samplerate": 44100,
        "analysers": {
          "loudness": {
            "active": true,
            "type": "rms",
            "responsiveness": 0.5,
            "controls": ["intensity"],
            "windows_per_second": 30,
            "updates_per_second": 30
          }
        }
      }
    }
  },
  "mapper": {
    "sources": [
      "velocity",
      "ornament",
      "drone",
      "tempo",
      "legato",
      "intensity"
    ],
    "targets": [],
    "rules": [
      "0.5 : %velocity,%ornament,%tempo,%drone,%legato",
      "intensity ~ velocity,ornament,tempo,drone,legato"
    ]
  }
}
